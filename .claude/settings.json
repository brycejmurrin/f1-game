{
  "permissions": {
    "allow": [
      "mcp__github",
      "mcp__apex-tools",
      "mcp__playwright-official",
      "mcp__chrome-devtools",
      "mcp__js-debugger",
      "mcp__apex-lsp",
      "mcp__browserstack",
      "mcp__claude-code-remote",
      "mcp__Context7",
      "mcp__Claude_Docs",
      "mcp__plugin_browser-use_browser-use",
      "Bash",
      "Read",
      "Edit",
      "Write",
      "NotebookEdit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Skill",
      "Monitor",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "TaskGet",
      "TaskStop",
      "TodoWrite",
      "ToolSearch",
      "SendMessage",
      "ListAgents",
      "ReadNotifications",
      "SendUserFile",
      "EnterWorktree",
      "ExitWorktree",
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "LSP",
      "mcp__Google_Drive__search_files",
      "mcp__Google_Drive__read_file_content",
      "mcp__Google_Drive__get_file_metadata",
      "mcp__Google_Drive__list_recent_files",
      "mcp__Google_Drive__download_file_content",
      "mcp__Google_Drive__get_file_permissions",
      "mcp__TinyFish__search",
      "mcp__TinyFish__fetch_content",
      "mcp__TinyFish__get_search_usage",
      "mcp__TinyFish__list_fetch_usage",
      "mcp__TinyFish__get_wallet",
      "mcp__TinyFish__get_run",
      "mcp__TinyFish__list_runs"
    ],
    "ask": [
      "Bash(gh api * -X DELETE *)",
      "Bash(gh api * --method DELETE *)",
      "Bash(gh workflow run *)",
      "mcp__github__actions_run_trigger"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push *--force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push *+*)",
      "Bash(git push * claude/f1-game-project-26h3ng*)",
      "Bash(git push *:claude/f1-game-project-26h3ng*)",
      "Bash(git push *refs/heads/claude/f1-game-project-26h3ng*)",
      "Bash(git push *--no-verify*)",
      "Bash(git push --no-verify *)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git config * core.hooksPath*)",
      "Bash(git config core.hooksPath*)",
      "Bash(git config --global *)",
      "Bash(gh run cancel *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr ready *)",
      "Bash(pkill -f *)",
      "Bash(killall *)",
      "Bash(node tools/ci/bump-cache.mjs --apply*)",
      "Bash(node tools/gen/assets.mjs bake*)",
      "Bash(node tools/track/rotate-markings.cjs --write*)",
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge",
      "mcp__github__disable_pr_auto_merge",
      "mcp__github__update_pull_request_branch",
      "mcp__github__delete_file",
      "mcp__github__create_repository",
      "mcp__github__fork_repository",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "mcp__github__create_branch",
      "mcp__apex-tools__apex_codex_control",
      "Skill(agent-protocols:ship)",
      "Skill(agent-protocols:build)",
      "Skill(agent-protocols:plan)",
      "Skill(agent-protocols:git-workflow-and-versioning)",
      "Skill(agent-protocols:ci-cd-and-automation)",
      "Skill(agent-protocols:shipping-and-launch)",
      "Skill(engineering:code-review)",
      "Skill(engineering:debug)",
      "Skill(engineering:deploy-checklist)",
      "Skill(engineering:incident-response)",
      "Skill(agent-smith:create-agent)",
      "mcp__TinyFish__top_up_wallet",
      "mcp__TinyFish__create_dataset",
      "mcp__Google_Drive__share_file",
      "mcp__Google_Drive__trash_file",
      "mcp__Google_Drive__update_file",
      "mcp__Google_Drive__create_file",
      "mcp__Google_Drive__copy_file"
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "0"
  },
  "enabledMcpjsonServers": [
    "apex-tools",
    "playwright-official",
    "chrome-devtools",
    "js-debugger",
    "apex-lsp",
    "browserstack"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 300
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/memory-sync.sh\" restore",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.sh\"",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/bash-guard.sh\"",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "^mcp__(playwright-official__.*|chrome-devtools__.*|js-debugger__.*|apex-tools__apex_(eval|shot|shot_survey|agent|garage|hud_shot|hud_survey|hud_mock|track|ui_fit|ui_shot|ui_inspect|diagnostics|profile|job_start|debug_chrome)|plugin_browser-use.*|browserstack__(run\\w*Session|run\\w*Tests\\w*|take\\w*Screenshot|startAccessibilityScan|runPercyScan))$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/mcp-browser-guard.sh\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "^mcp__github__(merge_pull_request|enable_pr_auto_merge|disable_pr_auto_merge|update_pull_request|update_pull_request_branch|issue_write|actions_run_trigger|push_files|create_or_update_file|create_branch|delete_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/github-mcp-guard.sh\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent-contract.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/context-cap.py\" --guard",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/lsp-hint.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit.sh\"",
            "timeout": 90
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/context-cap.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/context-cap.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(code-hunter|finding-verifier|prior-art-scout|surface-reviewer|physics-contract-auditor|ci-red-triage|worker)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent-contract.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
