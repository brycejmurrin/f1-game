{
  "name": "apex26",
  "version": "1.0.0",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "precommit:fix": "node tools/check/ratchets.mjs --update --lower-only && npm run gen",
    "test": "node tools/ci/run-playwright.mjs",
    "test:render": "node tools/ci/run-playwright.mjs --project=render --workers=4",
    "test:results-flow": "node tools/ci/run-playwright.mjs --group test:results-flow",
    "test:smoke": "node tools/ci/run-playwright.mjs --group test:smoke",
    "test:webkit": "node tools/ci/run-playwright.mjs --group test:webkit",
    "test:xr": "node tools/ci/run-playwright.mjs --group test:xr",
    "test:gfx": "node tools/ci/run-playwright.mjs --group test:gfx",
    "test:hooks": "node tools/ci/run-playwright.mjs --group test:hooks",
    "test:circuits": "node tools/ci/run-playwright.mjs --group test:circuits",
    "test:collisions": "node tools/ci/run-playwright.mjs --group test:collisions",
    "test:aero": "node tools/ci/run-playwright.mjs --group test:aero",
    "test:phone-recorder": "node tools/ci/run-playwright.mjs --group test:phone-recorder",
    "test:perf-frametime": "node tools/ci/run-playwright.mjs --group test:perf-frametime",
    "test:physics-core": "node tools/ci/run-playwright.mjs --group test:physics-core",
    "test:car": "node tools/ci/run-playwright.mjs --group test:car",
    "test:input": "node tools/ci/run-playwright.mjs --group test:input",
    "test:garage-unit": "node tools/ci/run-group.mjs test:garage-unit",
    "test:desktop-unit": "node tools/ci/run-group.mjs test:desktop-unit",
    "test:mobile-unit": "node tools/ci/run-group.mjs test:mobile-unit",
    "test:steering-unit": "node tools/ci/run-group.mjs test:steering-unit",
    "test:ui": "node tools/ci/run-playwright.mjs --group test:ui",
    "test:gallery": "node tools/ci/run-playwright.mjs --group test:gallery",
    "test:baseline": "node tools/ci/run-playwright.mjs --group test:baseline",
    "test:audio-unit": "node tools/ci/run-group.mjs test:audio-unit",
    "test:modes": "node tools/ci/run-playwright.mjs --group test:modes",
    "test:agent-contract": "node tools/ci/run-group.mjs test:agent-contract",
    "test:net": "node tools/ci/run-playwright.mjs --group test:net",
    "rtc:e2e": "node tools/net/rtc-e2e.mjs",
    "rtc:e2e-3p": "node tools/net/rtc-e2e-3p.mjs",
    "rtc:e2e-3p-relay": "node tools/net/rtc-e2e-3p.mjs --relay",
    "test:net-unit": "node tools/ci/run-group.mjs test:net-unit",
    "test:lifecycle-unit": "node tools/ci/run-group.mjs test:lifecycle-unit",
    "test:state-unit": "node tools/ci/run-group.mjs test:state-unit",
    "test:service-worker": "node tools/ci/run-group.mjs test:service-worker",
    "test:tooling": "npm run test:tooling-fast && npm run test:sweeps",
    "test:tooling-fast": "node tools/ci/tooling-fast.mjs",
    "test:guards": "node tools/ci/guards-verdict.mjs run",
    "gen": "node tools/gen/gen-circuit-meta.mjs && node tools/gen/gen-shell.mjs && node desktop/scripts/notices.mjs && node tools/gen/title-art.mjs && node tools/gen/gen-test-groups.mjs && node tools/gen/gen-cursor-rules.mjs && npm run gen:docs",
    "gen:check": "node tools/gen/gen-circuit-meta.mjs --check && node tools/gen/gen-shell.mjs --check && node tools/gen/title-art.mjs --check && node tools/gen/gen-test-groups.mjs --check && node tools/gen/gen-cursor-rules.mjs --check && node tools/gen/gen-tools-readme.mjs --check && node tools/gen/gen-slider-doc.mjs --check && node tools/gen/gen-hooks-table.mjs --check && node tools/gen/gen-flags-table.mjs --check && node tools/gen/gen-arch-table.mjs --check && node tools/docs/gen-coverage-table.mjs --check && node tools/docs/gen-agent-index.mjs --check && node tools/gen/gen-output-surface.mjs --check && node tools/gen/gen-locales.mjs --check && node tools/gen/gen-changelog.mjs --check && node desktop/scripts/notices.mjs --check",
    "fold": "node tools/gen/gen-changelog.mjs --fold",
    "gen:docs": "node tools/gen/gen-tools-readme.mjs && node tools/gen/gen-slider-doc.mjs && node tools/gen/gen-hooks-table.mjs && node tools/gen/gen-flags-table.mjs && node tools/gen/gen-arch-table.mjs && node tools/docs/gen-coverage-table.mjs && node tools/docs/gen-agent-index.mjs && node tools/gen/gen-output-surface.mjs && node tools/gen/gen-locales.mjs",
    "test:vm-page": "node tools/ci/run-group.mjs test:vm-page",
    "test:vm-page-a": "APEX_VM_PAGE_GROUP=a node --test tests/unit/adapted-specs.test.mjs",
    "test:vm-page-b": "APEX_VM_PAGE_GROUP=b node --test tests/unit/adapted-specs.test.mjs",
    "test:game-vm": "node tools/ci/run-group.mjs test:game-vm",
    "test:game-vm-a": "node tools/ci/run-group.mjs test:game-vm-a",
    "test:game-vm-b1": "node tools/ci/run-group.mjs test:game-vm-b1",
    "test:game-vm-b2": "node tools/ci/run-group.mjs test:game-vm-b2",
    "test:game-vm-b": "node tools/ci/run-group.mjs test:game-vm-b",
    "test:mcp": "node tools/ci/run-group.mjs test:mcp",
    "test:docs-guards": "node tools/ci/run-group.mjs test:docs-guards",
    "test:node-slow": "node tools/ci/run-group.mjs test:node-slow",
    "test:sweeps-parts": "node tools/ci/run-group.mjs test:sweeps-parts",
    "test:sweeps": "node tools/ci/run-group.mjs test:sweeps",
    "test:tiny": "node tools/ci/run-playwright.mjs --group test:tiny",
    "test:shimmer": "APEX_SHIMMER=1 node tools/ci/run-playwright.mjs tests/specs/material-shimmer.spec.js",
    "test:graph-parity": "node tools/track/graph-parity.cjs --all",
    "test:float": "node tools/track/float-audit.cjs --all",
    "test:clip": "node tools/track/clip-audit.cjs --all --gate",
    "test:audit": "node tools/ci/test-coverage-audit.mjs",
    "typecheck": "node tools/check/check-gctx.mjs",
    "ui:survey": "node tools/ui/layout-audit.mjs --survey",
    "ui:gallery": "node tools/ui/layout-audit.mjs --gallery",
    "ui:audit": "node tools/ui/layout-audit.mjs",
    "wgx:gallery": "node tools/gfx/wgx-shot.mjs --gallery --lite",
    "wgx:capture": "node tools/gfx/gfx-probe.mjs --backend webgpu",
    "prepare": "git config core.hooksPath .githooks || true && node tools/gen/ensure-built.mjs",
    "test:perf-race-entry": "node tools/ci/run-playwright.mjs --group test:perf-race-entry",
    "test:perf-session": "node tools/ci/run-playwright.mjs --group test:perf-session",
    "debug:unit": "node tools/ci/debug-unit.mjs",
    "memory:list": "node tools/env/apex-memory.mjs list",
    "memory:show": "node tools/env/apex-memory.mjs show",
    "memory:retire": "node tools/env/apex-memory.mjs retire",
    "test:agent-output": "node tools/ci/run-group.mjs test:agent-output",
    "test:perf-budget": "node tools/ci/run-playwright.mjs --group test:perf-budget",
    "test:perf-idle-churn": "node tools/ci/run-playwright.mjs --group test:perf-idle-churn",
    "test:stall-reload-sw": "node tools/ci/run-playwright.mjs --group test:stall-reload-sw",
    "test:offline-precache": "node tools/ci/run-playwright.mjs --group test:offline-precache"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "1.63.0",
    "axe-core": "4.14.0",
    "eslint-scope": "^9.1.2",
    "espree": "^11.2.0",
    "fast-check": "4.10.2",
    "gltf-validator": "2.0.0-dev.3.10",
    "iwer": "^2.5.0",
    "jsqr": "^1.4.0",
    "monocart-coverage-reports": "2.13.0",
    "playwright": "1.63.0",
    "sharp": "^0.35.4",
    "terser": "5.51.2",
    "typescript": "^7.0.2",
    "yaml": "2.9.1"
  },
  "description": "Apex 26 — unofficial 3D F1 fan game (three.js on WebGPU or WebGL2, WebGL2 fallback). No build step, no runtime dependencies; static files served from GitHub Pages.",
  "repository": {
    "type": "git",
    "url": "https://github.com/brycejmurrin/f1-game.git"
  },
  "license": "UNLICENSED"
}
