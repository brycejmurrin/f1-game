# Agent working directories (git worktrees created by background agents) and
# local Claude settings — but keep the shared developer skills tracked.
.claude/*
!.claude/skills/

# Node
node_modules/

# Regenerable output
scratch/
artifacts/

# Transient agent/debug scripts must be underscore-prefixed.
tools/_*.mjs

# git worktrees for isolated agent work
.worktrees/
