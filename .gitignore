# Agent working directories (git worktrees created by background agents) and
# local Claude settings — but keep the shared developer skills + agents tracked.
.claude/*
!.claude/skills/
!.claude/agents/
!.claude/workflows/
!.claude/hooks/
!.claude/settings.json

# Node (both the real dir and the self-referential symlink worktree runs create)
node_modules/
node_modules
# Regenerable output
scratch/
artifacts/
# Playwright MCP user-data-dir (repo playwright-mcp.sh + host occupancy)
.playwright-mcp/
# Transient agent/debug scripts must be underscore-prefixed.
tools/_*.mjs
tools/_*.cjs
tools/_*.js
# ...and stray dotfiles/backups a parallel agent leaves behind, which a
# blanket `git add -A` would otherwise commit (tools/.vt-warn.cjs did).
tools/.*
*.bak
*.orig
*~
# git worktrees for isolated agent work
.worktrees/
assets/pack/src/
# Any __pycache__, not just tools/'s: the Phase 4 move put the python tools in
# tools/mcp/, the old path-specific rule stopped matching, and the .pyc there
# became TRACKED — which then blocked two deploys as a dirty tree.
**/__pycache__/
