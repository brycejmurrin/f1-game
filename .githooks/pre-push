#!/usr/bin/env bash
# .githooks/pre-push — the push rules for EVERY agent host (AGENTS.md §Git
# branch & deploy): never push the deploy branch directly (it takes work only
# through a PR), never force-push, never delete a remote branch, never push
# over another author's fresh commits. This binds Claude Code, Cursor, Codex
# and Grok Build alike (installed by `npm run prepare` / the SessionStart hook
# as core.hooksPath=.githooks). Server-side branch protection remains the
# backstop for the deploy branch.
# stdin: "<local ref> <local sha> <remote ref> <remote sha>" per ref (git-scm.com/docs/githooks#_pre_push).
set -u
REMOTE="${1:-origin}"
DEPLOY="refs/heads/claude/f1-game-project-26h3ng"
ZERO=0000000000000000000000000000000000000000
# The one exception: spec-timings.yml force-pushes a rolling proposal to
# bot/spec-timings from GitHub Actions. Only that exact ref, only in Actions.
BOT_ROLLING="refs/heads/bot/spec-timings"
# Foreign-pusher window (ported from the retired .claude/hooks/foreign_push.py,
# shared safety ban 3, Bryce 2026-10-22): a commit another author (or another
# Claude session: every one commits as the same email, so the Claude-Session
# trailer tells them apart) pushed to this branch in the last FOREIGN_HOURS,
# since this checkout last pushed it (the newest "update by push" reflog entry
# of the tracking ref; no entry = a first push, nothing to compare), refuses the
# push: someone else is live on your branch. land.yml's AUTO-SYNC merge of the
# deploy branch (a clean two-parent merge with GitHub's update-branch subject)
# is not foreign. APEX_FOREIGN_PUSH_OK=1 once, after you confirmed the branch is
# yours again, pushes and moves the baseline.
FOREIGN_HOURS="${APEX_FOREIGN_HOURS:-12}"
sid() { printf '%s' "${1:-}" | sed -nE 's/.*(session|cse)_([A-Za-z0-9]+).*/\2/p'; }
foreign() {   # $1 = branch, $2 = remote sha as fetched; prints the foreign commits
  local ref="refs/remotes/$REMOTE/$1" base me mine
  base=$(git reflog show --format='%H %gs' "$ref" -- 2>/dev/null | awk '$2=="update" && $3=="by" && $4=="push"{print $1; exit}')
  [ -n "$base" ] || return 0
  me=$(git config user.email 2>/dev/null | tr 'A-Z' 'a-z')
  mine=$(sid "${CLAUDE_CODE_REMOTE_SESSION_ID:-}")
  git log --first-parent --since="$FOREIGN_HOURS hours ago" \
      --format='%H%x09%ae%x09%an%x09%s%x09%P%x09%(trailers:key=Claude-Session,valueonly,separator=%x20)' "$2" "^$base" 2>/dev/null \
  | while IFS=$'\t' read -r sha email name subj parents trailer; do
      other=$(sid "$trailer")
      if [ "$(printf '%s' "$email" | tr 'A-Z' 'a-z')" = "$me" ] && { [ -z "$mine" ] || [ -z "$other" ] || [ "$other" = "$mine" ]; }; then continue; fi
      case "$subj" in "Merge branch 'claude/f1-game-project-26h3ng' into "*)
        if [ "$(printf '%s' "$parents" | wc -w)" = 2 ] && [ -z "$(git diff-tree --cc --no-commit-id -r "$sha" 2>/dev/null)" ]; then continue; fi ;;
      esac
      printf '  %s %s <%s> %s\n' "${sha:0:9}" "$name" "$email" "${subj:0:70}"
    done
}
rc=0
while read -r lref lsha rref rsha; do
  [ -z "${rref:-}" ] && continue
  if [ "$rref" = "$DEPLOY" ]; then
    echo "pre-push: BLOCKED — the deploy branch takes work only through a PR." >&2; rc=1; continue
  fi
  if [ "$lsha" = "$ZERO" ]; then
    echo "pre-push: BLOCKED — deleting $rref (prune-branches.yml deletes merged branches)." >&2; rc=1; continue
  fi
  [ "$rsha" = "$ZERO" ] && continue   # a new branch
  if [ "$rref" = "$BOT_ROLLING" ] && [ "${GITHUB_ACTIONS:-}" = "true" ]; then continue; fi
  if ! git cat-file -e "$rsha^{commit}" 2>/dev/null; then
    echo "pre-push: BLOCKED — $rref moved on the remote ($rsha is not here). Fetch, merge it (node tools/ci/sync-pr.mjs), then push." >&2; rc=1; continue
  fi
  if ! git merge-base --is-ancestor "$rsha" "$lsha"; then
    echo "pre-push: BLOCKED — pushing $rref would rewrite its history (a force push). Merge instead of rebasing (node tools/ci/sync-pr.mjs)." >&2; rc=1; continue
  fi
  if [ "${APEX_FOREIGN_PUSH_OK:-}" != 1 ]; then
    found=$(foreign "${rref#refs/heads/}" "$rsha")
    if [ -n "$found" ]; then
      printf 'pre-push: BLOCKED — %s gained commits from another author in the last %s h since this checkout last pushed it (shared safety ban 3):\n%s\nAnother session or a person is live on your branch: stand down and say so in one PR comment. When it is confirmed yours again, fetch and merge, then push once with APEX_FOREIGN_PUSH_OK=1.\n' "${rref#refs/heads/}" "$FOREIGN_HOURS" "$found" >&2
      rc=1
    fi
  fi
done
exit $rc
