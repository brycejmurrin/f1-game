#!/usr/bin/env bash
# .githooks/pre-commit — the commit gate for EVERY agent host, not just Claude.
# Activated by `core.hooksPath=.githooks` (package.json "prepare", run by every
# host's `npm install`). AGENTS.md §Verification 3: a commit runs test:guards;
# a docs-only commit runs docs-integrity alone; ratchet growth <= 40 lines is
# auto-raised into the commit. Until 2026-10-14 this lived only in Claude
# Code's PreToolUse hook (.claude/hooks/bash-guard.sh), so Cursor, Codex and
# Grok Build committed unguarded (docs/notes/AGENT-GUARDS-2026-10-14.md).
#
# Claude Code sessions (CLAUDECODE=1) already ran the same gate in bash-guard.sh
# before git started, so it is not run twice. APEX_SKIP_GUARDS=1 bypasses, as
# there.
#
# #2889 slice 1: reuse a green test:guards verdict for the same staged tree
# (artifacts/pre-commit-guards.ok, 10 min — same file/format as bash-guard.sh)
# via tools/ci/guards-verdict.mjs; optional apex.guardTimeout / APEX_GUARD_TIMEOUT
# wraps the suite in `timeout -k 5` (no new default when unset).
set -u
[ "${APEX_SKIP_GUARDS:-}" = 1 ] && exit 0
[ -n "${CLAUDECODE:-}" ] && exit 0
ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$ROOT" || exit 1
mkdir -p artifacts
LOG=artifacts/pre-commit-guards.log
# Tests create their own Git repositories. Keep the hook's staged-index context
# for ratchets/git add, but do not let fixture subprocesses inherit its selectors.
without_local_git_context() (
  local git_name
  while IFS= read -r git_name; do unset "$git_name"; done < <(git rev-parse --local-env-vars)
  "$@"
)
if [ ! -d node_modules ]; then
  echo "pre-commit: BLOCKED — node_modules is missing, so test:guards cannot run. Install first (npm install, or bash tools/env/cloud-agent-install.sh)." >&2
  exit 1
fi
STAGED=$(git diff --cached --name-only --no-renames)
[ -z "$STAGED" ] && exit 0
GENERATED=" $(node tools/gen/targets.mjs 2>/dev/null | tr '\n' ' ') "
DOCS_ONLY=1
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$GENERATED" in *" $f "*) DOCS_ONLY=0; break ;; esac
  printf '%s' "$f" | grep -Eq '^(docs/|\.claude/skills/|\.claude/agents/)|\.md$' || { DOCS_ONLY=0; break; }
done <<LIST
$STAGED
LIST
# Guards read working-tree bytes. On a miss, certify that they are the bytes
# Git will commit, using the hook's actual index (including -a/pathspec indexes).
# Keep this check before ratchet auto-staging so a refusal preserves the index.
require_index_worktree_match() {
  git diff --quiet --no-ext-diff -- . ':(exclude).claude/memory/**'
  local rc=$?
  [ "$rc" = 0 ] && return 0
  echo "pre-commit: BLOCKED — guards read the working tree, which does not match the commit index. Stage or stash unstaged tracked changes, then retry." >&2
  [ "$rc" = 1 ] && git diff --name-only -- . ':(exclude).claude/memory/**' >&2
  return 1
}
# A matching earlier verdict already certifies this index even if the worktree
# subsequently changed. Never scrub GIT_INDEX_FILE for a commit cache lookup.
if [ "$DOCS_ONLY" != 1 ] && node tools/ci/guards-verdict.mjs check; then
  exit 0
fi
require_index_worktree_match || exit 1
if [ "$DOCS_ONLY" = 1 ]; then
  GUARD_TREE=$(git write-tree) || exit 1
  if ! without_local_git_context node --test tests/unit/docs-integrity.test.mjs >"$LOG" 2>&1; then
    echo "pre-commit: BLOCKED — docs-integrity is red ($LOG):" >&2
    grep -E 'not ok|expected|actual' "$LOG" | tail -15 >&2
    exit 1
  fi
  require_index_worktree_match || exit 1
  [ "$(git write-tree)" = "$GUARD_TREE" ] || { echo "pre-commit: BLOCKED — commit index changed while docs-integrity ran." >&2; exit 1; }
  exit 0
fi
# Capture the generator's actual outputs, including new topic fragments and
# deletions from lowering/folding. Stage only bytes it changed, into THIS hook
# index; a globbed git add would also pick up unrelated pre-existing fragments.
if node --input-type=module >artifacts/pre-commit-ratchets.log 2>&1 <<'NODE'
import fs from "node:fs";
import path from "node:path";
import { spawnSync } from "node:child_process";
const base = "tests/data/ratchets.json", dir = "tests/data/ratchets.d";
const snapshot = () => new Map([base, ...(fs.existsSync(dir)
  ? fs.readdirSync(dir).filter((name) => name.endsWith(".json")).map((name) => `${dir}/${name}`) : [])]
  .filter((file) => fs.existsSync(file)).map((file) => [file, fs.readFileSync(file)]));
const before = snapshot();
const tracked = spawnSync("git", ["ls-files", "-z", "--", base, dir], { encoding: "utf8", stdio: ["ignore", "pipe", "inherit"] });
if (tracked.status !== 0) process.exit(1);
const indexed = new Set(tracked.stdout.split("\0"));
const untracked = [...before.keys()].filter((file) => !indexed.has(file));
if (untracked.length) {
  console.error(`ratchets: untracked guard inputs must be staged or stashed first: ${untracked.join(", ")}`);
  process.exit(1);
}
const result = spawnSync(process.execPath, ["tools/check/ratchets.mjs", "--auto-raise"], { stdio: "inherit" });
if (result.status !== 0) process.exit(result.status || 1);
const after = snapshot();
const changed = [...new Set([...before.keys(), ...after.keys()])]
  .filter((file) => !before.has(file) || !after.has(file) || !before.get(file).equals(after.get(file)));
if (changed.length) {
  // Ask Git for this worktree's regular index without replacing the active
  // selector. Only that index and its full-commit (-a) lock reconcile extras;
  // partial/custom indexes must refuse rather than leave a ceiling deleted.
  const regularEnv = { ...process.env };
  delete regularEnv.GIT_INDEX_FILE;
  const regular = spawnSync("git", ["rev-parse", "--git-path", "index"], {
    env: regularEnv, encoding: "utf8", stdio: ["ignore", "pipe", "inherit"],
  });
  if (regular.status !== 0) process.exit(1);
  const normal = path.resolve(regular.stdout.trim());
  const active = path.resolve(process.env.GIT_INDEX_FILE || normal);
  if (active !== normal && active !== normal + ".lock") {
    console.error("ratchets: pathspec commit needs generated outputs that Git cannot reconcile (partial/custom index):");
    for (const file of changed) console.error(`  ${file}`);
    console.error("ratchets: stage these outputs with the intended commit contents, then retry git commit without pathspecs/--only using the regular index.");
    process.exit(1);
  }
  const staged = spawnSync("git", ["--literal-pathspecs", "add", "-A", "--", ...changed], { stdio: "inherit" });
  if (staged.status !== 0) process.exit(staged.status || 1);
}
NODE
then
  grep '^RAISED\|^LOWERED' artifacts/pre-commit-ratchets.log >&2 || true
else
  echo "pre-commit: BLOCKED — ratchet check or auto-staging failed (artifacts/pre-commit-ratchets.log):" >&2
  tail -15 artifacts/pre-commit-ratchets.log >&2
  exit 1
fi
# Verdict cache (#2889): a fresh green write-tree match skips the suite.
# Printed on stdout so agents see the hit line; the suite log stays for misses.
if node tools/ci/guards-verdict.mjs check; then
  exit 0
fi
require_index_worktree_match || exit 1
GUARD_TREE=$(git write-tree) || exit 1
# Budget: git config apex.guardTimeout, then APEX_GUARD_TIMEOUT. When neither
# is set, keep today's behaviour (no new default timeout in this githook).
BUDGET=$(git config --get apex.guardTimeout 2>/dev/null || true)
[ -z "${BUDGET:-}" ] && BUDGET="${APEX_GUARD_TIMEOUT:-}"
# test:guards builds throwaway fixture repos; git exported GIT_DIR, GIT_INDEX_FILE
# & co. into this hook (absolute in a linked worktree, the index.lock for -a), so
# their git would act on THIS repo (#1807). Unset them for the suite only: the
# ratchet auto-raise above must still stage into the commit's own index.
# The idiom is githooks(5)'s own: https://git-scm.com/docs/githooks#_description
# shellcheck disable=SC2046
# Capture RC outside `if ! …` — bash resets $? to 0 after a successful `if !`
# test, which would hide timeout's 124 and report a plain "red" instead.
if [ -n "${BUDGET:-}" ]; then
  ( unset $(git rev-parse --local-env-vars); timeout -k 5 "$BUDGET" npm run --silent test:guards ) >"$LOG" 2>&1
  RC=$?
  if [ "$RC" != 0 ]; then
    if [ "$RC" = 124 ] || [ "$RC" = 137 ]; then
      echo "pre-commit: BLOCKED — npm run test:guards did not finish within ${BUDGET}s (apex.guardTimeout / APEX_GUARD_TIMEOUT). Retry on an idle box, raise the budget with \`git config apex.guardTimeout <sec>\`, or APEX_SKIP_GUARDS=1 only when the guards themselves are the change. Log: $LOG" >&2
      exit 1
    fi
    echo "pre-commit: BLOCKED — npm run test:guards is red (AGENTS.md §Verification 3). Last lines of $LOG:" >&2
    grep -E 'not ok|Error|expected|actual' "$LOG" | tail -20 >&2
    exit 1
  fi
else
  if ! ( unset $(git rev-parse --local-env-vars); npm run --silent test:guards ) >"$LOG" 2>&1; then
    echo "pre-commit: BLOCKED — npm run test:guards is red (AGENTS.md §Verification 3). Last lines of $LOG:" >&2
    grep -E 'not ok|Error|expected|actual' "$LOG" | tail -20 >&2
    exit 1
  fi
fi
require_index_worktree_match || exit 1
[ "$(git write-tree)" = "$GUARD_TREE" ] || { echo "pre-commit: BLOCKED — commit index changed while guards ran." >&2; exit 1; }
exit 0
