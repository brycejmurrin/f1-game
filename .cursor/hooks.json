{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      { "command": "bash .cursor/hooks/shell-guard.sh", "timeout": 30, "failClosed": true }
    ],
    "preToolUse": [
      { "command": "bash .cursor/hooks/edit-guard.sh", "timeout": 30, "failClosed": true }
    ],
    "beforeMCPExecution": [
      { "command": "bash .cursor/hooks/mcp-guard.sh", "timeout": 10, "failClosed": true }
    ]
  }
}
