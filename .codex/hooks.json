{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/shell-guard.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^mcp__(?:.*__|codex_apps__github_)(merge_pull_request|enable_pr_auto_merge|update_pull_request|actions_run_trigger|push_files|create_or_update_file|create_branch|delete_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/mcp-guard.sh",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
