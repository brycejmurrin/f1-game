{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .cursor/hooks/shell-guard.sh",
            "timeout": 200
          }
        ]
      },
      {
        "matcher": "^mcp__.*__(merge_pull_request|enable_pr_auto_merge|update_pull_request|actions_run_trigger)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/mcp-guard.sh",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
