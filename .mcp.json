{
  "mcpServers": {
    "apex-tools": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "tools/mcp/output-level-mcp.sh",
        "--server",
        "apex-tools",
        "--",
        "bash",
        "tools/mcp/apex-tools-mcp.sh",
        "serve"
      ],
      "timeout": 900000
    },
    "playwright-official": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "tools/mcp/output-level-mcp.sh",
        "--server",
        "playwright-official",
        "--",
        "bash",
        "tools/mcp/playwright-mcp.sh",
        "run"
      ]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "tools/mcp/output-level-mcp.sh",
        "--server",
        "chrome-devtools",
        "--",
        "bash",
        "tools/mcp/chrome-devtools-mcp.sh",
        "run"
      ]
    },
    "js-debugger": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "tools/mcp/output-level-mcp.sh",
        "--server",
        "js-debugger",
        "--",
        "bash",
        "tools/mcp/js-debugger-mcp.sh",
        "serve"
      ]
    },
    "apex-lsp": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "tools/mcp/output-level-mcp.sh",
        "--server",
        "apex-lsp",
        "--",
        "bash",
        "tools/mcp/lsp-mcp.sh",
        "serve"
      ]
    }
  }
}
