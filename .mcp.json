{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless",
        "--isolated",
        "--executablePath",
        "/opt/pw-browsers/chromium",
        "--memoryDebugging",
        "--viewport",
        "844x390",
        "--chromeArg=--no-sandbox",
        "--chromeArg=--use-angle=swiftshader"
      ]
    }
  }
}
