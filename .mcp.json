{
  "mcpServers": {
    "apex-tools": {
      "type": "stdio",
      "command": "bash",
      "args": ["tools/mcp/apex-tools-mcp.sh", "serve"]
    },
    "playwright-official": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.79"]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "bash",
      "args": ["tools/mcp/chrome-devtools-mcp.sh", "run"]
    }
  }
}
