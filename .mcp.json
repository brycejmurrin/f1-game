{
  "mcpServers": {
    "apex-tools": {
      "type": "stdio",
      "command": "bash",
      "args": ["tools/apex-tools-mcp.sh", "serve"]
    },
    "playwright": {
      "type": "stdio",
      "command": "bash",
      "args": ["tools/playwright-mcp.sh", "run"]
    },
    "tinyfish": {
      "url": "http://127.0.0.1:3711/mcp"
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "bash",
      "args": ["tools/chrome-devtools-mcp.sh", "run"]
    },
    "probe": {
      "type": "stdio",
      "command": "python3",
      "args": ["tools/probe-mcp.py", "serve"]
    }
  }
}
